{
  "name": "Jonokotha: alert on urgent cases",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Run now (test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        160
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.JONOKOTHA_URL }}/api/internal/urgent-cases?hours=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CRON_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Read urgent open cases",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Alert once per case: remember the refs seen in the last 7 days (kept in the workflow's static data).\nconst d = $getWorkflowStaticData('global');\nd.seen = d.seen || {};\nconst cases = ($input.first().json.data || {}).cases || [];\nconst fresh = cases.filter((c) => !d.seen[c.ref]);\nconst now = Date.now();\nfor (const c of cases) d.seen[c.ref] = now;\nfor (const k of Object.keys(d.seen)) if (now - d.seen[k] > 7 * 864e5) delete d.seen[k];\nif (!fresh.length) return [];\nconst line = (c) => `- ${c.ref}: ${c.title} (${c.category}${c.area ? ', ' + c.area : ''}, ${c.status})`;\nreturn [{ json: { count: fresh.length, text: `Jonokotha: ${fresh.length} new urgent case${fresh.length === 1 ? '' : 's'}\\n${fresh.map(line).join('\\n')}` } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Only cases not alerted yet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Send alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Read urgent open cases",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read urgent open cases": {
      "main": [
        [
          {
            "node": "Only cases not alerted yet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only cases not alerted yet": {
      "main": [
        [
          {
            "node": "Send alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (test)": {
      "main": [
        [
          {
            "node": "Read urgent open cases",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
